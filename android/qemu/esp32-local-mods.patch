+    uint64_t tick_ps = (conf1 & (1u << 17)) ? 12500ull * div : 1000000ull * div;   /* ref_always_on: 1 = APB 80 MHz, 0 = REF_TICK 1 MHz */
+    uint64_t total_ps = 0;
