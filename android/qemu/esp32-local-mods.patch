+static void rmt_update_irq(Esp32GpioState *s)
+{
+    RMTR(RMT_INT_ST) = RMTR(RMT_INT_RAW) & RMTR(RMT_INT_ENA);
+    qemu_set_irq(s->rmt_irq, RMTR(RMT_INT_ST) != 0);
