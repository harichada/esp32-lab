+static void handle_line(Esp32GpioState *s, const char *l)
+{
+    unsigned a, b, c;
+    if (sscanf(l, "K %u", &a) == 1) { s->i2c_ack = a; }
+    else if (sscanf(l, "B %u", &a) == 1) { s->i2c_rx = a & 0xff; }
+    else if (sscanf(l, "A %u %u %u", &a, &b, &c) == 3) { if (a < 2 && b < 12) s->adc[a][b] = c & 0xffff; }
+    else if (sscanf(l, "I %u %u", &a, &b) == 2) { s->regs[0x3c >> 2] = a; s->regs[0x40 >> 2] = b; }
+    else if (sscanf(l, "Y %u", &a) == 1) { s->sync = a != 0; }
+    else if (l[0] == 'V' && l[1] == ' ') {   /* SPI MISO bytes, hex */
+        int n = 0; const char *p = l + 2;
+        while (n < 64 && p[0] && p[1]) { unsigned v; if (sscanf(p, "%2x", &v) != 1) break; s->spi_rx[n++] = v; p += 2; }
+        s->spi_rxn = n;
+    }
+    else if (l[0] == 'Z' && l[1] == ' ') { s->spi_csmask = strtoull(l + 2, NULL, 10); }
+}
+
+static void sync_wait(Esp32GpioState *s)
+{
+    char line[320]; int n = 0;
+    if (!s->sync || !qemu_chr_fe_backend_connected(&s->chr)) return;
+    while (1) {
+        uint8_t ch;
+        int r = qemu_chr_fe_read_all(&s->chr, &ch, 1);
+        if (r <= 0) { s->sync = false; return; }
+        if (ch == '\n') {
+            line[n] = 0; handle_line(s, line);
+            if (line[0] == 'I' || !s->sync) return;
+            n = 0;
+        } else if (n < (int)sizeof(line) - 1) {
+            line[n++] = ch;
+        }
+    }
+}
+
+static void send_state(Esp32GpioState *s)
+{
+    char b[96];
+    snprintf(b, sizeof b, "S %u %u %u %u\n", R(OUT), R(OUT1) & 0xff, R(EN), R(EN1) & 0xff);
+    send_line(s, b);
+    sync_wait(s);
+}
 
