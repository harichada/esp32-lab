+#define RMT_CONF1(n) (0x24 + 8 * (n))
+#define RMT_INT_RAW 0xa0
+#define RMT_INT_ST  0xa4
+#define RMT_INT_ENA 0xa8
+#define RMT_INT_CLR 0xac
+#define RMT_CARRIER(n) (0xb0 + 4 * (n))
